# Optional. The hub runs fully without any of these (local-first mode).
RUN_SECRET=change-me-long-random-string
# Shared leaderboards (Upstash Redis REST). Without them boards use your device + the sample community.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret for /api/cron/* jobs
CRON_SECRET=

# Discord bot (see /discord page for the 6 step setup)
DISCORD_PUBLIC_KEY=
NEXT_PUBLIC_DISCORD_APP_ID=
NEXT_PUBLIC_SITE_URL=
# Only for scripts/register-commands.mjs, never put the bot token in Vercel
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
# Optional: Dot posts the Daily Five here at 00:00 UTC (Discord channel webhook)
DISCORD_WEBHOOK_URL=
