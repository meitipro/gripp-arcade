# Optional. The hub runs fully without any of these (local-first mode).
RUN_SECRET=change-me-long-random-string
# Shared leaderboards (Upstash Redis REST). Without them boards use your device + the sample community.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret for /api/cron/* jobs
CRON_SECRET=
